{
  "openai": {
    "name": "openai",
    "base_url": "${OPENAI_BASE_URL:https://api.openai.com/v1}",
    "path": "/chat/completions",
    "method": "POST",
    "timeout": "${OPENAI_TIMEOUT:30s}",
    "api_key": "${OPENAI_API_KEY}",
    "headers": {
      "Content-Type": "application/json",
      "Accept": "application/json"
    }
  },
  "google_oauth": {
    "name": "google_oauth",
    "base_url": "${GOOGLE_OAUTH_BASE_URL:https://oauth2.googleapis.com}",
    "path": "/token",
    "method": "POST",
    "timeout": "${GOOGLE_OAUTH_TIMEOUT:15s}",
    "client_id": "${GOOGLE_CLIENT_ID}",
    "client_secret": "${GOOGLE_CLIENT_SECRET}",
    "redirect_url": "${GOOGLE_REDIRECT_URL:http://localhost:8080/api/v1/auth/google/callback}",
    "integration_redirect_url": "${GOOGLE_INTEGRATION_REDIRECT_URL:http://localhost:8080/api/v1/integrations/google/callback}",
    "auth_url": "${GOOGLE_AUTH_URL:https://accounts.google.com/o/oauth2/v2/auth}",
    "userinfo_url": "${GOOGLE_USERINFO_URL:https://openidconnect.googleapis.com/v1/userinfo}",
    "scopes": "${GOOGLE_OAUTH_SCOPES:openid,email,profile,https://www.googleapis.com/auth/calendar}",
    "integration_scopes": "${GOOGLE_INTEGRATION_SCOPES:openid,email,profile,https://www.googleapis.com/auth/calendar}",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded",
      "Accept": "application/json"
    }
  },
  "microsoft_oauth": {
    "name": "microsoft_oauth",
    "base_url": "${MICROSOFT_OAUTH_BASE_URL:https://login.microsoftonline.com/common/oauth2/v2.0}",
    "path": "/token",
    "method": "POST",
    "timeout": "${MICROSOFT_OAUTH_TIMEOUT:15s}",
    "client_id": "${MICROSOFT_CLIENT_ID}",
    "client_secret": "${MICROSOFT_CLIENT_SECRET}",
    "redirect_url": "${MICROSOFT_REDIRECT_URL:http://localhost:8080/api/v1/auth/microsoft/callback}",
    "integration_redirect_url": "${MICROSOFT_INTEGRATION_REDIRECT_URL:http://localhost:8080/api/v1/integrations/microsoft/callback}",
    "tenant": "${MICROSOFT_TENANT_ID:}",
    "auth_url": "${MICROSOFT_AUTH_URL:https://login.microsoftonline.com/common/oauth2/v2.0/authorize}",
    "token_url": "${MICROSOFT_TOKEN_URL:https://login.microsoftonline.com/common/oauth2/v2.0/token}",
    "graph_me_url": "${MICROSOFT_GRAPH_ME_URL:https://graph.microsoft.com/v1.0/me}",
    "scopes": "${MICROSOFT_OAUTH_SCOPES:openid,profile,email,offline_access,User.Read,Calendars.ReadWrite}",
    "integration_scopes": "${MICROSOFT_INTEGRATION_SCOPES:openid,profile,email,offline_access,User.Read,Calendars.ReadWrite}",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded",
      "Accept": "application/json"
    }
  },
  "ai_service": {
    "name": "ai_service",
    "base_url": "${AI_SERVICE_URL:http://localhost:8090}",
    "path": "/health",
    "method": "GET",
    "timeout": "${AI_SERVICE_TIMEOUT:10s}",
    "headers": {
      "Accept": "application/json"
    }
  }
}
