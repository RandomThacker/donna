# Copy to repo root as .env for local development. Never commit real secrets.

# Postgres — API uses DATABASE_URL only (no POSTGRES_HOST / POSTGRES_PORT).
# Local Docker Postgres (optional; start with: docker compose up postgres):
# DATABASE_URL=postgres://donna:donna@localhost:5432/donna?sslmode=disable
# Remote (e.g. Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# API
API_ADDR=:8080
# Alias for API_ADDR when API_ADDR is unset: PORT=8080
API_ENV=development
# Alias for API_ENV when API_ENV is unset: ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Production (Vercel → Railway): no trailing slash. Example:
# CORS_ORIGINS=https://donna-rust.vercel.app
# JSON configs directory (services/api/configs by default; Docker uses /app/configs)
# CONFIG_DIR=configs

# Auth secrets (required for API boot)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=24h
# Optional dedicated key for sealing provider refresh tokens (defaults to JWT_SECRET)
# CREDENTIALS_ENCRYPTION_KEY=
AUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/callback
INTEGRATION_FRONTEND_SUCCESS_URL=http://localhost:3000/dashboard/settings
# Local: false. Production (HTTPS + cross-site Vercel/Railway): true
# When true, session cookie uses SameSite=None (required for cross-origin fetch).
COOKIE_SECURE=false
# Deprecated alias for JWT_SECRET:
# SESSION_SECRET=change-me-to-a-long-random-string

# Web Push (VAPID) — browser push for reminders / timeline alerts
# Generate: cd apps/web && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:donna@localhost

# Google OAuth — login (includes calendar so the signed-in account auto-links)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar
# Google calendar connect (additional accounts)
GOOGLE_INTEGRATION_REDIRECT_URL=http://localhost:8080/api/v1/integrations/google/callback
GOOGLE_INTEGRATION_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar

# Microsoft OAuth — multi-tenant (any Entra org + personal Microsoft accounts)
# Authorize/token always use /common/. Do not use a tenant GUID in these URLs.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL=http://localhost:8080/api/v1/auth/microsoft/callback
MICROSOFT_OAUTH_SCOPES=openid,profile,email,offline_access,User.Read,Calendars.ReadWrite
# Microsoft calendar connect (additional accounts)
MICROSOFT_INTEGRATION_REDIRECT_URL=http://localhost:8080/api/v1/integrations/microsoft/callback
MICROSOFT_INTEGRATION_SCOPES=openid,profile,email,offline_access,User.Read,Calendars.ReadWrite
MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
# Optional — not used for OAuth authorize/token (reserved for future Graph admin/ops).
# MICROSOFT_TENANT_ID=

# Web — pick one profile via apps/web:
#   npm run env:local  → local FE + local API (:8080)
#   npm run env:prod   → local FE + Railway API (proxy)
#   npm run dev:local / npm run dev:prod
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Production (Vercel):
#   API_PROXY_TARGET=https://YOUR-API.up.railway.app
#   NEXT_PUBLIC_API_BASE_URL=same-origin
#   GOOGLE_REDIRECT_URL=https://YOUR-APP.vercel.app/api/v1/auth/google/callback
#   GOOGLE_INTEGRATION_REDIRECT_URL=https://YOUR-APP.vercel.app/api/v1/integrations/google/callback
AUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/callback
INTEGRATION_FRONTEND_SUCCESS_URL=http://localhost:3000/dashboard/settings

# AI service
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_ADDR=:8090
OPENAI_API_KEY=
# or ANTHROPIC_API_KEY=
