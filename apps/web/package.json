{
  "name": "@donna/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env:local": "cp env/local.env .env.local && echo '→ Local FE + local API (http://localhost:8080)'",
    "env:prod": "cp env/prod.env .env.local && echo '→ Local FE + prod API (Railway via /api proxy)'",
    "dev": "next dev --port 3000",
    "dev:local": "npm run env:local && next dev --port 3000",
    "dev:prod": "npm run env:prod && next dev --port 3000",
    "build": "npm run icons && next build",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "start": "next start --port 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.3.0"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "brace-expansion": ">=5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
